# /etc/africair/api.env — non-secret runtime settings for africair-api.service
# Owner: root:africair  Mode: 0640
# Copy this file to /etc/africair/api.env and adjust values.
# Restart the service after any change: systemctl restart africair-api
#
# Secrets (ADMIN_TOKEN, PROMO_CODES, DATABASE_URL) are NOT set here.
# They are delivered by systemd LoadCredential= as files under %d/ and
# referenced via the *_FILE variables in the unit file.

APP_ENV=staging
APP_VERSION=1.0.0
# GIT_SHA is injected by deploy.sh at release time — do not set it here.

BRAND_NAME=AfricAir
SUPPORT_EMAIL=support@africair.example
SUPPORT_PHONE=

ANNOUNCEMENT_TEXT=Welcome to the AfricAir staging server
ANNOUNCEMENT_LEVEL=info

SERVICE_FEE_USD=9
DEFAULT_CURRENCY=KES
DEFAULT_LANGUAGE=

MAINTENANCE_MODE=false

FEATURE_DESTINATIONS=true
FEATURE_MY_TRIPS=true
FEATURE_PROMO_CODES=true

SECRET_REFRESH_SECONDS=10
SHUTDOWN_DELAY_MS=5000
LOG_LEVEL=info
