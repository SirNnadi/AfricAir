# syntax=docker/dockerfile:1

# ── Stage 1: deps ─────────────────────────────────────────────────────────────
# Install all workspace dependencies with a BuildKit cache mount so the pnpm
# store is reused across builds and never written into an image layer.
FROM node:22-alpine AS deps
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json ./server/
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

# ── Stage 2: test ─────────────────────────────────────────────────────────────
# Run quality gates. The build fails here if TypeScript or unit tests fail,
# so a broken commit can never produce a runtime image.
FROM deps AS test
COPY . .
RUN pnpm check && pnpm test

# ── Stage 3: build ────────────────────────────────────────────────────────────
# Produce dist/. version.json is written from build args so the image carries
# its own provenance without needing a git clone at runtime.
FROM test AS build
ARG VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown
RUN pnpm build
RUN node -e " \
  const fs = require('fs'); \
  fs.writeFileSync('dist/version.json', JSON.stringify({ \
    commit: '${GIT_SHA}', version: '${VERSION}', builtAt: '${BUILD_DATE}' \
  }));"

# ── Stage 4: runtime ──────────────────────────────────────────────────────────
# Only dist/ and the nginx template land in the final image — no Node, no source.
# nginxinc/nginx-unprivileged runs as uid 101 (non-root) on port 8080.
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

ARG VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.source="https://github.com/SirNnadi/AfricAir" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}"

# Copy static files
COPY --from=build /app/dist /usr/share/nginx/html

# Copy the envsubst template. nginx-unprivileged's entrypoint runs envsubst on
# every *.template in /etc/nginx/templates/ and writes the result to
# /etc/nginx/conf.d/ before starting nginx.
COPY deploy/nginx/templates/africair.conf.template /etc/nginx/templates/

# Remove the default nginx config so only our template is active
RUN rm -f /etc/nginx/conf.d/default.conf

EXPOSE 8080

# BusyBox wget is available in the alpine image; curl is not.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:8080/healthz || exit 1
