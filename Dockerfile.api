# syntax=docker/dockerfile:1

# ── Stage 1: build ────────────────────────────────────────────────────────────
# Install all workspace deps and compile the API TypeScript to server/dist/.
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY server/package.json ./server/
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile
COPY . .
RUN pnpm build:api

# ── Stage 2: prod-deps ────────────────────────────────────────────────────────
# Use `pnpm deploy` to produce a self-contained directory with only the
# production dependencies for the @africair/api package — no TypeScript,
# no Vite, no React. This is what goes into the runtime image.
FROM build AS prod-deps
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm deploy --filter @africair/api --prod --legacy /prod

# ── Stage 3: runtime ──────────────────────────────────────────────────────────
# Minimal image: compiled JS + migrations + prod node_modules only.
# node:22-alpine gives us a small base with Node already present.
# USER node (uid 1000) satisfies the non-root requirement.
FROM node:22-alpine AS runtime

ARG VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.source="https://github.com/SirNnadi/AfricAir" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}"

WORKDIR /app

# Copy only what the API needs at runtime
COPY --from=build     /app/server/dist       ./dist
COPY --from=build     /app/server/migrations ./migrations
COPY --from=build     /app/server/package.json ./
COPY --from=prod-deps /prod/node_modules     ./node_modules

USER node

EXPOSE 4000 9464

# Run Node directly as PID 1 so SIGTERM is delivered to the app, not to a
# shell wrapper. With `pnpm start` as CMD, pnpm becomes PID 1 and does not
# forward signals — docker stop takes 10 s and the graceful shutdown never runs.
CMD ["node", "dist/index.js"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget -qO- http://localhost:4000/api/healthz || exit 1
